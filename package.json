{
  "name": "quintessence-sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Rules sandbox for The Quintessence Project: do the v0 local rules produce the section-6 machines on their own?",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json",
    "sweep": "tsx scripts/sweep.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
